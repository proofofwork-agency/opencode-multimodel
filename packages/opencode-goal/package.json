{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "opencode-goal",
  "version": "0.2.0-alpha.0",
  "description": "Persisted /goal runtime for OpenCode that continues a session until evidence-backed completion",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "engines": {
    "bun": ">=1.3.0",
    "opencode": ">=1.18.15"
  },
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./tui": {
      "types": "./dist/tui.d.ts",
      "import": "./dist/tui.js"
    },
    "./core": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "alpha"
  },
  "scripts": {
    "clean": "bun -e 'import { rm } from \"node:fs/promises\"; await rm(\"dist\", { recursive: true, force: true })'",
    "build": "bun run clean && bun build src/index.ts src/server.ts src/tui.ts --outdir dist --target bun --format esm --packages external && tsc -p tsconfig.build.json",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run test && bun run typecheck && bun run build"
  },
  "dependencies": {
    "@opencode-ai/plugin": "1.18.15",
    "@opencode-ai/sdk": "1.18.15"
  },
  "devDependencies": {
    "@tsconfig/bun": "1.0.9",
    "@types/bun": "1.3.13",
    "typescript": "5.8.2"
  },
  "keywords": [
    "opencode",
    "goal",
    "plugin",
    "autonomy"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/proofofwork-agency/opencode.git",
    "directory": "packages/opencode-goal"
  },
  "homepage": "https://github.com/proofofwork-agency/opencode/tree/main/packages/opencode-goal#readme",
  "bugs": {
    "url": "https://github.com/proofofwork-agency/opencode/issues"
  }
}
