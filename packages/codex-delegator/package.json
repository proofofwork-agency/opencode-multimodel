{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "codex-delegator",
  "version": "0.1.0",
  "description": "A reusable Bun library for delegating work to a local OpenAI Codex CLI",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "engines": {
    "bun": ">=1.3.0"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "PROVENANCE.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "alpha"
  },
  "scripts": {
    "clean": "bun -e 'import { rm } from \"node:fs/promises\"; await rm(\"dist\", { recursive: true, force: true })'",
    "build": "bun run clean && bun build src/index.ts --outdir dist --target bun --format esm --packages external && tsc -p tsconfig.build.json",
    "test": "bun test --timeout 30000",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run test && bun run typecheck && bun run build"
  },
  "devDependencies": {
    "@tsconfig/bun": "1.0.9",
    "@types/bun": "1.3.13",
    "typescript": "5.8.2"
  },
  "keywords": [
    "codex",
    "openai",
    "delegation",
    "agent",
    "bun"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/proofofwork-agency/opencode-multimodel.git",
    "directory": "packages/codex-delegator"
  },
  "homepage": "https://github.com/proofofwork-agency/opencode-multimodel/tree/main/packages/codex-delegator#readme",
  "bugs": {
    "url": "https://github.com/proofofwork-agency/opencode-multimodel/issues"
  }
}
