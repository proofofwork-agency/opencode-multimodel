{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "opencode-btw",
  "version": "0.2.0-alpha.0",
  "description": "Ephemeral /btw side questions for OpenCode sessions without polluting the main transcript",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "engines": {
    "bun": ">=1.3.0",
    "opencode": ">=1.18.15"
  },
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./tui": {
      "types": "./dist/tui.d.ts",
      "import": "./dist/tui.js"
    },
    "./core": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "alpha"
  },
  "scripts": {
    "build": "bun run scripts/build.ts && tsc -p tsconfig.build.json",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run test && bun run typecheck && bun run build"
  },
  "dependencies": {
    "@opencode-ai/plugin": "1.18.15",
    "@opencode-ai/sdk": "1.18.15"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.4.5",
    "@opentui/keymap": ">=0.4.5",
    "@opentui/solid": ">=0.4.5",
    "solid-js": ">=1.9.0"
  },
  "peerDependenciesMeta": {
    "@opentui/core": {
      "optional": true
    },
    "@opentui/keymap": {
      "optional": true
    },
    "@opentui/solid": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@opentui/core": "0.4.5",
    "@opentui/keymap": "0.4.5",
    "@opentui/solid": "0.4.5",
    "@tsconfig/bun": "1.0.9",
    "@types/bun": "1.3.13",
    "solid-js": "1.9.12",
    "typescript": "5.8.2"
  },
  "keywords": [
    "opencode",
    "btw",
    "side-question",
    "plugin",
    "context"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/proofofwork-agency/opencode.git",
    "directory": "packages/opencode-btw"
  },
  "homepage": "https://github.com/proofofwork-agency/opencode/tree/main/packages/opencode-btw#readme",
  "bugs": {
    "url": "https://github.com/proofofwork-agency/opencode/issues"
  }
}
